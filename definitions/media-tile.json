{
  "name": "MediaTile",
  "params": {
    "title": "Untitled"
  },
  "template": {
    "type": "Pressable",
    "props": {
      "action": {
        "$bind": "action"
      },
      "lift": true,
      "style": {
        "gap": 2,
        "hoverGroup": true
      }
    },
    "children": [
      {
        "type": "Box",
        "props": {
          "style": {
            "position": "relative",
            "radius": "md",
            "overflow": "hidden",
            "aspectRatio": "16 / 9",
            "bg": "surface-raised",
            "glass": true,
            "border": true,
            "shadow": "2"
          }
        },
        "children": [
          {
            "type": "Image",
            "props": {
              "src": {
                "$bind": "poster"
              },
              "alt": {
                "$bind": "title"
              },
              "placeholder": {
                "$bind": "mediaType"
              },
              "artLight": "focus",
              "style": {
                "width": "full",
                "height": "full"
              }
            }
          },
          {
            "type": "Box",
            "props": {
              "$if": {
                "$bind": "badge"
              },
              "style": {
                "position": "absolute",
                "top": 2,
                "left": 2,
                "glass": true,
                "bg": "surface-overlay",
                "border": true,
                "radius": "sm",
                "px": 2,
                "py": 1
              }
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "text": {
                    "$bind": "badge"
                  },
                  "style": {
                    "variant": "xs",
                    "weight": "medium"
                  }
                }
              }
            ]
          },
          {
            "type": "Box",
            "props": {
              "style": {
                "position": "absolute",
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0,
                "hoverReveal": true,
                "scrim": "bottom",
                "direction": "row",
                "align": "end",
                "gap": 3,
                "p": 3
              }
            },
            "children": [
              {
                "type": "Box",
                "props": {
                  "style": {
                    "width": 34,
                    "height": 34,
                    "radius": "pill",
                    "bg": "text",
                    "align": "center",
                    "justify": "center"
                  }
                },
                "children": [
                  {
                    "type": "Icon",
                    "props": {
                      "name": "play",
                      "size": 13,
                      "color": "bg"
                    }
                  }
                ]
              },
              {
                "type": "Text",
                "props": {
                  "$if": {
                    "$bind": "progressLabel"
                  },
                  "text": {
                    "$bind": "progressLabel"
                  },
                  "style": {
                    "variant": "xs",
                    "color": "text-muted"
                  }
                }
              }
            ]
          },
          {
            "type": "Box",
            "props": {
              "$if": {
                "$bind": "progress"
              },
              "style": {
                "position": "absolute",
                "left": 2,
                "right": 2,
                "bottom": 2
              }
            },
            "children": [
              {
                "type": "ProgressBar",
                "props": {
                  "value": {
                    "$bind": "progress"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Box",
        "props": {
          "style": {
            "gap": 0
          }
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "text": {
                "$bind": "title"
              },
              "style": {
                "variant": "sm",
                "weight": "medium",
                "lineClamp": 1
              }
            }
          },
          {
            "type": "Text",
            "props": {
              "$if": {
                "$bind": "subtitle"
              },
              "text": {
                "$bind": "subtitle"
              },
              "style": {
                "variant": "xs",
                "color": "text-muted"
              }
            }
          }
        ]
      }
    ]
  }
}
