{
  "name": "Carousel",
  "params": {
    "itemWidth": 196
  },
  "template": {
    "type": "Box",
    "props": {
      "style": {
        "layout": "grid",
        "gridFlow": "column",
        "gridAutoColumns": {
          "$bind": "itemWidth"
        },
        "gap": 4,
        "overflowX": "auto",
        "snap": "x",
        "py": 2,
        "snapAlign": "start"
      }
    },
    "children": [
      {
        "type": "Outlet"
      }
    ]
  }
}
