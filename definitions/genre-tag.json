            "align": "center",
            "bg": "surface-raised",
            "glass": true,
            "border": true,
            "radius": "pill",
            "px": 3
          }
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "text": {
                "$bind": "label"
              },
              "style": {
                "variant": "xs",
                "color": "text-muted"
              }
            }
          }
        ]
      }
    ]
