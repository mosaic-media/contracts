{
  "name": "SettingsNavItem",
  "params": {
    "icon": "settings"
  },
  "template": {
    "type": "Pressable",
    "props": {
      "action": {
        "$bind": "action"
      },
      "label": {
        "$bind": "label"
      },
      "style": {
        "direction": "row",
        "align": "center",
        "justify": "between",
        "gap": 3,
        "px": 4,
        "py": 3,
        "radius": "pill",
        "bg": {
          "$match": {
            "on": {
              "$bind": "active"
            },
            "cases": {
              "true": "accent-quiet"
            }
          }
        },
        "color": {
          "$match": {
            "on": {
              "$bind": "active"
            },
            "cases": {
              "true": "text"
            },
            "default": "text-muted"
          }
        },
        "responsive": {
          "below": 720,
          "style": {
            "py": 4,
            "px": 3,
            "bg": null,
            "color": "text"
          }
        },
        "pl": {
          "$match": {
            "on": {
              "$bind": "indent"
            },
            "cases": {
              "true": 6
            },
            "default": 4
          }
        }
      }
    },
    "children": [
      {
        "type": "Box",
        "props": {
          "style": {
            "direction": "row",
            "align": "center",
            "gap": 3
          }
        },
        "children": [
          {
            "type": "Icon",
            "props": {
              "name": {
                "$bind": "icon"
              },
              "size": "1.15em"
            }
          },
          {
            "type": "Text",
            "props": {
              "text": {
                "$bind": "label"
              },
              "style": {
                "variant": "sm",
                "weight": "medium"
              }
            }
          }
        ]
      },
      {
        "type": "Box",
        "props": {
          "style": {
            "direction": "row",
            "align": "center",
            "gap": 2
          }
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "$if": {
                "$bind": "badge"
              },
              "text": {
                "$bind": "badge"
              },
              "style": {
                "variant": "xs",
                "weight": "medium",
                "color": "accent"
              }
            }
          },
          {
            "type": "Box",
            "props": {
              "style": {
                "hidden": true,
                "color": "text-faint",
                "responsive": {
                  "below": 720,
                  "style": {
                    "hidden": false
                  }
                }
              }
            },
            "children": [
              {
                "type": "Icon",
                "props": {
                  "name": "chevron-right",
                  "size": "1.1em"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
