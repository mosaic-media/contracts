{
  "name": "SetupFrame",
  "params": {
    "brand": "Mosaic"
  },
  "template": {
    "type": "Box",
    "props": {
      "style": {
        "direction": "row",
        "align": "stretch",
        "width": "full",
        "minHeight": "screen",
        "bg": "bg",
        "responsive": {
          "below": 900,
          "style": {
            "direction": "column"
          }
        }
      }
    },
    "children": [
      {
        "type": "Box",
        "props": {
          "style": {
            "direction": "column",
            "gap": 6,
            "width": 328,
            "minWidth": 328,
            "px": 5,
            "py": 7,
            "bg": "surface",
            "borderSide": "right",
            "border": true,
            "borderColor": "border",
            "responsive": {
              "below": 900,
              "style": {
                "width": "full",
                "minWidth": 0,
                "borderSide": "bottom"
              }
            }
          }
        },
        "children": [
          {
            "type": "Box",
            "props": {
              "style": {
                "direction": "row",
                "align": "center",
                "gap": 3
              }
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "text": {
                    "$bind": "brand"
                  },
                  "style": {
                    "variant": "lg",
                    "weight": "bold",
                    "tracking": "wide",
                    "transform": "uppercase"
                  }
                }
              },
              {
                "type": "Box",
                "props": {
                  "style": {
                    "px": 2,
                    "py": 1,
                    "radius": "sm",
                    "bg": "surface-raised",
                    "border": true
                  }
                },
                "children": [
                  {
                    "type": "Text",
                    "props": {
                      "text": "Setup",
                      "style": {
                        "variant": "xs",
                        "color": "text-muted",
                        "transform": "uppercase",
                        "tracking": "wide"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "Box",
            "props": {
              "style": {
                "direction": "column",
                "gap": 1
              }
            },
            "children": [
              {
                "type": "Outlet",
                "props": {
                  "name": "nav"
                }
              }
            ]
          },
          {
            "type": "Box",
            "props": {
              "style": {
                "grow": true
              }
            }
          },
          {
            "type": "Box",
            "props": {
              "style": {
                "direction": "column",
                "gap": 2
              }
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "$if": {
                    "$bind": "step"
                  },
                  "text": {
                    "$bind": "step"
                  },
                  "style": {
                    "variant": "xs",
                    "color": "text-muted"
                  }
                }
              },
              {
                "type": "Text",
                "props": {
                  "$if": {
                    "$bind": "footnote"
                  },
                  "text": {
                    "$bind": "footnote"
                  },
                  "style": {
                    "variant": "xs",
                    "color": "text-faint"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Box",
        "props": {
          "style": {
            "position": "relative",
            "grow": true,
            "minWidth": 0,
            "overflow": "hidden"
          }
        },
        "children": [
          {
            "type": "Box",
            "props": {
              "style": {
                "position": "absolute",
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0,
                "glow": "ambient"
              }
            }
          },
          {
            "type": "Box",
            "props": {
              "style": {
                "position": "absolute",
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0,
                "grain": true
              }
            }
          },
          {
            "type": "Box",
            "props": {
              "style": {
                "position": "relative",
                "direction": "column",
                "gap": 5,
                "maxWidth": 808,
                "pt": 8,
                "px": 8,
                "pb": 7
              }
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "$if": {
                    "$bind": "kicker"
                  },
                  "text": {
                    "$bind": "kicker"
                  },
                  "style": {
                    "variant": "xs",
                    "color": "accent",
                    "transform": "uppercase",
                    "tracking": "wide"
                  }
                }
              },
              {
                "type": "Box",
                "props": {
                  "style": {
                    "direction": "column",
                    "gap": 2
                  }
                },
                "children": [
                  {
                    "type": "Text",
                    "props": {
                      "text": {
                        "$bind": "title"
                      },
                      "style": {
                        "variant": "3xl",
                        "weight": "bold",
                        "tracking": "tight"
                      }
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "$if": {
                        "$bind": "lead"
                      },
                      "text": {
                        "$bind": "lead"
                      },
                      "style": {
                        "variant": "md",
                        "color": "text-muted",
                        "maxWidth": 520
                      }
                    }
                  }
                ]
              },
              {
                "type": "Box",
                "props": {
                  "style": {
                    "maxWidth": 680
                  }
                },
                "children": [
                  {
                    "type": "Outlet",
                    "props": {
                      "name": "form"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
