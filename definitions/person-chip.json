{
  "name": "PersonChip",
  "template": {
    "type": "Pressable",
    "props": {
      "action": {
        "$bind": "action"
      },
      "lift": true,
      "style": {
        "direction": "column",
        "align": "center",
        "gap": 0,
        "width": 132
      }
    },
    "children": [
      {
        "type": "Box",
        "props": {
          "style": {
            "width": "full",
            "aspectRatio": "1 / 1",
            "radius": "pill",
            "overflow": "hidden",
            "bg": "surface-raised",
            "border": true
          }
        },
        "children": [
          {
            "type": "Image",
            "props": {
              "src": {
                "$bind": "avatar"
              },
              "alt": {
                "$bind": "name"
              },
              "fit": "cover",
              "placeholder": {
                "$bind": "name"
              },
              "placeholderMode": "initials",
              "style": {
                "width": "full",
                "height": "full"
              }
            }
          }
        ]
      },
      {
        "type": "Box",
        "props": {
          "style": {
            "pt": 3,
            "align": "center"
          }
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "text": {
                "$bind": "name"
              },
              "style": {
                "variant": "sm",
                "weight": "medium",
                "align": "center",
                "lineClamp": 1
              }
            }
          }
        ]
      },
      {
        "type": "Box",
        "props": {
          "$if": {
            "$bind": "role"
          },
          "style": {
            "pt": 1,
            "align": "center"
          }
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "text": {
                "$bind": "role"
              },
              "style": {
                "variant": "xs",
                "color": "text-muted",
                "align": "center",
                "lineClamp": 1
              }
            }
          }
        ]
      }
    ]
  }
}
