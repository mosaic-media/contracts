{
  "name": "DetailHero",
  "template": {
    "type": "Box",
    "props": {
      "style": {
        "position": "relative",
        "direction": "row",
        "align": "end",
        "width": "full",
        "minHeight": "screen",
        "overflow": "hidden"
      }
    },
    "children": [
      {
        "type": "Image",
        "props": {
          "src": {
            "$bind": "backdrop"
          },
          "alt": {
            "$bind": "title"
          },
          "fit": "cover",
          "placeholder": " ",
          "artLight": "ambient",
          "motion": "drift",
          "style": {
            "position": "absolute",
            "top": 0,
            "right": 0,
            "bottom": 0,
            "left": 0,
            "width": "full",
            "height": "full"
          }
        }
      },
      {
        "type": "Box",
        "props": {
          "style": {
            "position": "absolute",
            "top": 0,
            "right": 0,
            "bottom": 0,
            "left": 0,
            "glow": "art"
          }
        }
      },
      {
        "type": "Box",
        "props": {
          "style": {
            "position": "absolute",
            "top": 0,
            "right": 0,
            "bottom": 0,
            "left": 0,
            "scrim": "cinematic"
          }
        }
      },
      {
        "type": "Box",
        "props": {
          "style": {
            "position": "relative",
            "direction": "row",
            "align": "end",
            "gap": 7,
            "width": "full",
            "px": "gutter",
            "pt": 9,
            "pb": 7,
            "responsive": {
              "below": 1100,
              "style": {
                "direction": "column",
                "align": "start",
                "gap": 5,
                "pt": 8
              }
            }
          }
        },
        "children": [
          {
            "type": "Box",
            "props": {
              "$if": {
                "$bind": "poster"
              },
              "style": {
                "width": 236,
                "aspectRatio": "2 / 3",
                "radius": "lg",
                "overflow": "hidden",
                "bg": "surface-raised",
                "border": true,
                "borderColor": "border-strong",
                "shadow": "2",
                "responsive": {
                  "below": 900,
                  "style": {
                    "hidden": true
                  }
                },
                "minWidth": 236
              }
            },
            "children": [
              {
                "type": "Image",
                "props": {
                  "src": {
                    "$bind": "poster"
                  },
                  "alt": {
                    "$bind": "title"
                  },
                  "fit": "cover",
                  "placeholder": " ",
                  "style": {
                    "width": "full",
                    "height": "full"
                  }
                }
              }
            ]
          },
          {
            "type": "Box",
            "props": {
              "style": {
                "direction": "column",
                "align": "start",
                "gap": 3,
                "grow": true,
                "minWidth": 0,
                "maxWidth": 760
              }
            },
            "children": [
              {
                "type": "Box",
                "props": {
                  "$if": {
                    "$bind": "kicker"
                  },
                  "style": {
                    "direction": "row",
                    "align": "center",
                    "gap": 2,
                    "px": 3,
                    "py": 1,
                    "radius": "pill",
                    "bg": "surface-overlay",
                    "glass": true,
                    "border": true
                  }
                },
                "children": [
                  {
                    "type": "Box",
                    "props": {
                      "style": {
                        "width": 6,
                        "height": 6,
                        "radius": "pill",
                        "bg": "accent"
                      }
                    }
                  },
                  {
                    "type": "Text",
                    "props": {
                      "text": {
                        "$bind": "kicker"
                      },
                      "style": {
                        "variant": "xs",
                        "weight": "medium",
                        "color": "text-muted",
                        "transform": "uppercase",
                        "tracking": "wide"
                      }
                    }
                  }
                ]
              },
              {
                "type": "Image",
                "props": {
                  "$if": {
                    "$bind": "logo"
                  },
                  "src": {
                    "$bind": "logo"
                  },
                  "alt": {
                    "$bind": "title"
                  },
                  "fit": "contain",
                  "style": {
                    "width": 440,
                    "maxWidth": "full",
                    "height": 120,
                    "responsive": {
                      "below": 900,
                      "style": {
                        "width": 260,
                        "height": 80
                      }
                    },
                    "pt": 5
                  }
                }
              },
              {
                "type": "Box",
                "props": {
                  "$ifNot": {
                    "$bind": "logo"
                  },
                  "style": {
                    "pt": 5
                  }
                },
                "children": [
                  {
                    "type": "Text",
                    "props": {
                      "text": {
                        "$bind": "title"
                      },
                      "style": {
                        "variant": "4xl",
                        "weight": "bold",
                        "tracking": "tight",
                        "lineClamp": 2
                      }
                    }
                  }
                ]
              },
              {
                "type": "Text",
                "props": {
                  "$if": {
                    "$bind": "nativeTitle"
                  },
                  "text": {
                    "$bind": "nativeTitle"
                  },
                  "style": {
                    "variant": "md",
                    "color": "text-muted"
                  }
                }
              },
              {
                "type": "Box",
                "props": {
                  "$if": {
                    "$bind": "meta"
                  },
                  "style": {
                    "direction": "row",
                    "wrap": true,
                    "align": "center",
                    "gap": 2
                  }
                },
                "children": [
                  {
                    "type": "Box",
                    "props": {
                      "$each": {
                        "$bind": "meta"
                      },
                      "$as": "m",
                      "style": {
                        "px": 3,
                        "py": 1,
                        "radius": "pill",
                        "bg": "surface-overlay",
                        "glass": true,
                        "border": true
                      }
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "text": {
                            "$bind": "m"
                          },
                          "style": {
                            "variant": "xs",
                            "color": "text-muted"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Box",
                "props": {
                  "$if": {
                    "$bind": "showTags"
                  },
                  "style": {
                    "direction": "row",
                    "wrap": true,
                    "gap": 2
                  }
                },
                "children": [
                  {
                    "type": "Outlet",
                    "props": {
                      "name": "tags"
                    }
                  }
                ]
              },
              {
                "type": "Box",
                "props": {
                  "$if": {
                    "$bind": "overview"
                  },
                  "style": {
                    "pt": 1,
                    "maxWidth": 600
                  }
                },
                "children": [
                  {
                    "type": "Text",
                    "props": {
                      "text": {
                        "$bind": "overview"
                      },
                      "style": {
                        "variant": "md",
                        "color": "text-muted",
                        "lineClamp": 4
                      }
                    }
                  }
                ]
              },
              {
                "type": "Box",
                "props": {
                  "style": {
                    "direction": "row",
                    "align": "center",
                    "wrap": true,
                    "gap": 3,
                    "pt": 3
                  }
                },
                "children": [
                  {
                    "type": "Outlet",
                    "props": {
                      "name": "actions"
                    }
                  }
                ]
              },
              {
                "type": "Box",
                "props": {
                  "$if": {
                    "$bind": "credits"
                  },
                  "style": {
                    "pt": 3
                  }
                },
                "children": [
                  {
                    "type": "Text",
                    "props": {
                      "text": {
                        "$bind": "credits"
                      },
                      "style": {
                        "variant": "sm",
                        "color": "text-faint"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "Box",
            "props": {
              "style": {
                "width": 312,
                "responsive": {
                  "below": 1100,
                  "style": {
                    "width": "full",
                    "minWidth": 0
                  }
                },
                "minWidth": 312
              }
            },
            "children": [
              {
                "type": "Outlet",
                "props": {
                  "name": "aside"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Box",
        "props": {
          "style": {
            "position": "absolute",
            "top": 0,
            "right": 0,
            "bottom": 0,
            "left": 0,
            "grain": true
          }
        }
      }
    ]
  }
}
