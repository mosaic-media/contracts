{
  "name": "Section",
  "params": {
    "actionLabel": "See all"
  },
  "template": {
    "type": "Box",
    "props": {
      "style": {
        "gap": 4,
        "hoverGroup": true
      }
    },
    "children": [
      {
        "type": "Box",
        "props": {
          "$if": {
            "$bind": "title"
          },
          "style": {
            "direction": "row",
            "align": "baseline",
            "gap": 4
          }
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "text": {
                "$bind": "title"
              },
              "style": {
                "variant": "lg",
                "weight": "medium",
                "tracking": "tight"
              }
            }
          },
          {
            "type": "Text",
            "props": {
              "$if": {
                "$bind": "subtitle"
              },
              "text": {
                "$bind": "subtitle"
              },
              "style": {
                "variant": "sm",
                "color": "text-faint"
              }
            }
          },
          {
            "type": "Pressable",
            "props": {
              "$if": {
                "$bind": "action"
              },
              "action": {
                "$bind": "action"
              },
              "style": {
                "direction": "row",
                "align": "center",
                "gap": 1,
                "color": "text-faint",
                "hoverReveal": true
              }
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "text": {
                    "$bind": "actionLabel"
                  },
                  "style": {
                    "variant": "xs"
                  }
                }
              },
              {
                "type": "Icon",
                "props": {
                  "name": "arrow-right",
                  "size": "1em"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Outlet"
      }
    ]
  }
}
