{
  "name": "EpisodeRow",
  "template": {
    "type": "Pressable",
    "props": {
      "action": {
        "$bind": "action"
      },
      "style": {
        "layout": "grid",
        "gridColumns": [
          196,
          {
            "fill": 1
          },
          "auto"
        ],
        "gap": 5,
        "align": "start",
        "p": 3,
        "radius": "md",
        "hoverGroup": true
      }
    },
    "children": [
      {
        "type": "Box",
        "props": {
          "style": {
            "position": "relative",
            "aspectRatio": "16 / 9",
            "radius": "sm",
            "overflow": "hidden",
            "bg": "surface-raised",
            "border": true
          }
        },
        "children": [
          {
            "type": "Image",
            "props": {
              "src": {
                "$bind": "thumbnail"
              },
              "alt": {
                "$bind": "title"
              },
              "fit": "cover",
              "placeholder": " ",
              "style": {
                "width": "full",
                "height": "full"
              }
            }
          },
          {
            "type": "Box",
            "props": {
              "style": {
                "position": "absolute",
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0,
                "hoverReveal": true,
                "align": "center",
                "justify": "center"
              }
            },
            "children": [
              {
                "type": "Box",
                "props": {
                  "style": {
                    "position": "absolute",
                    "top": 0,
                    "right": 0,
                    "bottom": 0,
                    "left": 0,
                    "bg": "bg",
                    "opacity": 0.5
                  }
                }
              },
              {
                "type": "Box",
                "props": {
                  "style": {
                    "position": "relative",
                    "width": 38,
                    "height": 38,
                    "radius": "pill",
                    "bg": "text",
                    "align": "center",
                    "justify": "center"
                  }
                },
                "children": [
                  {
                    "type": "Icon",
                    "props": {
                      "name": "play",
                      "size": 14,
                      "color": "bg"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "Box",
            "props": {
              "$if": {
                "$bind": "progress"
              },
              "style": {
                "position": "absolute",
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            },
            "children": [
              {
                "type": "ProgressBar",
                "props": {
                  "value": {
                    "$bind": "progress"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Box",
        "props": {
          "style": {
            "direction": "column",
            "gap": 2,
            "minWidth": 0
          }
        },
        "children": [
          {
            "type": "Box",
            "props": {
              "style": {
                "direction": "row",
                "align": "center",
                "gap": 3
              }
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "text": {
                    "$bind": "index"
                  },
                  "style": {
                    "variant": "xs",
                    "color": "text-faint",
                    "mono": true
                  }
                }
              },
              {
                "type": "Text",
                "props": {
                  "text": {
                    "$bind": "title"
                  },
                  "style": {
                    "variant": "md",
                    "weight": "medium",
                    "lineClamp": 1
                  }
                }
              },
              {
                "type": "Icon",
                "props": {
                  "$if": {
                    "$bind": "watched"
                  },
                  "name": "check",
                  "size": "0.9em",
                  "color": "success"
                }
              }
            ]
          },
          {
            "type": "Box",
            "props": {
              "$if": {
                "$bind": "overview"
              },
              "style": {
                "maxWidth": 640
              }
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "text": {
                    "$bind": "overview"
                  },
                  "style": {
                    "variant": "sm",
                    "color": "text-muted",
                    "lineClamp": 2
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Box",
        "props": {
          "style": {
            "direction": "column",
            "align": "end",
            "gap": 2
          }
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "$if": {
                "$bind": "runtime"
              },
              "text": {
                "$bind": "runtime"
              },
              "style": {
                "variant": "xs",
                "color": "text-muted"
              }
            }
          },
          {
            "type": "Box",
            "props": {
              "$if": {
                "$bind": "quality"
              },
              "style": {
                "px": 2,
                "py": 1,
                "radius": "pill",
                "bg": "surface-overlay",
                "glass": true,
                "border": true
              }
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "text": {
                    "$bind": "quality"
                  },
                  "style": {
                    "variant": "xs",
                    "color": "text-muted"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
